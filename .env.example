# =============================================================================
# HR Recruiting System — environment configuration (EXAMPLE)
#
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# NEVER commit the real `.env` to git — it is already in .gitignore.
# Every credential below includes instructions for obtaining it.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Used by the Postgres container AND the backend connection string.
POSTGRES_USER=hruser
POSTGRES_PASSWORD=hrpassword
POSTGRES_DB=hrdb
# Non-Docker setup only: point the backend at your local Postgres.
# DATABASE_URL=postgresql://hruser:hrpassword@localhost:5432/hrdb

# ── Runtime ───────────────────────────────────────────────────────────────────
# environment: development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true

# CORS: comma-separated allowed origins (NO wildcard in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Trust X-Forwarded-For when resolving the client IP for rate limiting.
# Enable ONLY behind a trusted reverse proxy (the bundled nginx is one).
# If enabled while the API is directly reachable, clients can spoof the
# header and evade per-IP limits entirely.
TRUST_PROXY_HEADERS=false

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Generate a strong secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRE_HOURS=8

# Seed password for the bootstrap 'admin' account. Leave empty for local dev:
# the well-known fallback (admin123) is seeded but a password change is FORCED
# on first login. Set a strong value for any shared/production deployment.
ADMIN_INITIAL_PASSWORD=

# ── AI Matching (free) ────────────────────────────────────────────────────────
# HOW TO GET: sign up free at https://console.groq.com -> API Keys -> Create.
# Optional: without it the system falls back to 3-component scoring
# (skills + experience + TF-IDF) and still works end to end.
GROQ_API_KEY=
# Current Groq free model (llama3-8b-8192 was decommissioned in 2025).
GROQ_MODEL=llama-3.1-8b-instant
MATCH_THRESHOLD=55

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# HOW TO GET a Gmail App Password (your normal password will NOT work):
#   1. Google Account -> Security -> enable 2-Step Verification
#   2. Security -> "App passwords" (search for it) -> create one for "Mail"
#   3. Paste the 16-character code below (spaces optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
HR_FROM_NAME=HR Team

# ── Interviews / meetings ─────────────────────────────────────────────────────
# Meeting links are real Jitsi Meet rooms — no credentials needed. The room is
# created the moment the first participant opens the link.
MEET_BASE_URL=https://meet.jit.si
# Interview slot: LEAD_DAYS from now at INTERVIEW_HOUR local time, skipping
# the Bangladesh weekend (Friday/Saturday).
INTERVIEW_LEAD_DAYS=3
INTERVIEW_HOUR=10
TIMEZONE=Asia/Dhaka

# ── Uploads ───────────────────────────────────────────────────────────────────
# Maximum accepted CV size in megabytes.
MAX_UPLOAD_MB=10

# ── Job Platforms (all optional) ──────────────────────────────────────────────
# Telegram (easiest, free):
#   1. Chat with @BotFather on Telegram -> /newbot -> copy the token
#   2. Create a public channel, add the bot as an administrator
#   3. TELEGRAM_CHANNEL_ID is the channel handle, e.g. @yourchannel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# LinkedIn: requires a LinkedIn Developer app with the
# "Share on LinkedIn" / Community Management product approved.
# https://developer.linkedin.com -> My Apps -> Auth -> OAuth token.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=
# Twitter/X: https://developer.x.com -> create app -> keys & tokens.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
# Bdjobs employer account (no public API; used by the integration if set).
BDJOBS_USERNAME=
BDJOBS_PASSWORD=
# Generic webhook platform — point it at the n8n job-posted webhook (default
# in docker-compose) to get Telegram announcements via n8n.
JOB_WEBHOOK_URL=

# ── n8n Automation ────────────────────────────────────────────────────────────
# n8n >= 1.0: owner account is created on first visit to http://localhost:5678.
# The single master workflow + credentials auto-import on `docker compose up`
# (see n8n-workflows/README.md).
N8N_WEBHOOK_URL=http://n8n:5678/webhook/match-result
# Fired by the backend after every CV upload -> Branch A auto-runs the match.
N8N_CV_WEBHOOK_URL=http://n8n:5678/webhook/cv-uploaded
# JOB_WEBHOOK_URL=http://n8n:5678/webhook/job-posted   (docker-compose default)
APPLY_URL=careers@yourcompany.com

# Encryption key shared by n8n + n8n-import so auto-imported credentials decrypt.
# Change for production:  python -c "import secrets; print(secrets.token_urlsafe(32))"
N8N_ENCRYPTION_KEY=hr-local-dev-encryption-key-change-me

# Backend account the n8n workflow uses to call authenticated APIs
# (/match-all, /analytics/report). Matches the seeded admin by default.
N8N_BACKEND_USER=admin
N8N_BACKEND_PASSWORD=admin123

# Where the daily report (Branch D) is sent (falls back to SMTP_USER).
HR_ADMIN_EMAIL=

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=Asia/Dhaka
