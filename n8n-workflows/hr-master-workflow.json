    {
      "parameters": {
        "jsCode": "// Pick the job to match against: the uploaded payload may name a job_id;\n// otherwise use the NEWEST active job (sorted, not order-dependent).\n// If the payload identifies the candidate, match only that candidate --\n// avoids re-matching (and re-emailing) every pending candidate on each upload.\nconst hook = $('Trigger: CV Uploaded').first().json;\nconst payload = hook.body ?? hook;\nconst token = $('Login to Backend (Match)').first().json.access_token;\nif (!token) {\n  throw new Error('Backend login failed -- no access token in response');\n}\nconst jobs = $input\n  .all()\n  .flatMap((i) => (Array.isArray(i.json) ? i.json : [i.json]))\n  .filter((j) => j && j.id);\nconst active = jobs\n  .filter((j) => (j.status ?? 'active') === 'active')\n  .sort((a, b) => new Date(b.created_at || 0) - new Date(a.created_at || 0));\nconst jobId = payload.job_id || (active[0] && active[0].id);\nif (!jobId) {\n  throw new Error('No active job available to match against');\n}\nconst matchUrl = payload.candidate_id\n  ? `http://backend:8000/match/${payload.candidate_id}/${jobId}?auto_email=true`\n  : `http://backend:8000/match-all/${jobId}?auto_email=true`;\nreturn [{ json: { job_id: jobId, token, candidate_id: payload.candidate_id ?? null, match_url: matchUrl } }];"
      },
      "id": "a3-pick-job",
      "name": "Pick Target Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
