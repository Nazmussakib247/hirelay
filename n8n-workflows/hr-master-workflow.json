    {
      "parameters": {
        "jsCode": "// Build the announcement with HTML parse mode + escaping so job titles or\n// descriptions containing * _ [ ] < > & can never break Telegram formatting.\nconst hook = $('Trigger: Job Posted').first().json;\nconst b = hook.body ?? hook;\nif (!b.job_id || !b.job_title) {\n  throw new Error('Invalid job-posted payload: job_id and job_title are required');\n}\nconst esc = (s) => String(s ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\nconst skills = Array.isArray(b.required_skills) ? b.required_skills.join(', ') : '';\nconst desc = String(b.description || '').substring(0, 200);\nconst applyUrl = b.apply_url || 'careers@yourcompany.com';\nconst text =\n  `<b>We are hiring!</b>\\n\\n` +\n  `<b>${esc(b.job_title)}</b>\\n\\n` +\n  `Experience: ${Number(b.min_experience) || 0}+ years\\n` +\n  `Skills: ${esc(skills)}\\n\\n` +\n  `${esc(desc)}\\n\\n` +\n  `Apply: ${esc(applyUrl)}\\n\\n` +\n  `#hiring #jobs #career`;\nreturn [{ json: { job_id: b.job_id, text } }];"
      },
      "id": "c1-build-msg",
      "name": "Build Telegram Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 760]
    },
