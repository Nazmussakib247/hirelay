# ── Environment & Secrets ──────────────────────────────────────
# Ignore EVERY .env variant so real credentials never reach GitHub, but keep
# the committed template (.env.example) so anyone who clones can copy it and run.
.env
.env.*
!.env.example
# Never commit private keys / certificates.
*.pem
*.key
*.p12
secrets.json

# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
.Python

# ── Test / tooling caches ──────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ── Generated demo data ────────────────────────────────────────
sample_cvs/

# ── Node / Frontend ────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.cache/
frontend/vite.config.*.timestamp-*.mjs
*.log
npm-debug.log*

# ── Docker ─────────────────────────────────────────────────────
postgres_data/
n8n_data/

# ── IDE / OS ───────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
~$*
*.swp
*.swo

# ── Trash (local cleanup folder) ──────────────────────────────
Trash/
